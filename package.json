{
  "name": "telemetry",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:ios": "eas build --platform ios --profile internal",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint App.tsx index.ts src tests scripts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "validate": "npm run typecheck && npm test && npm run lint && npm run format:check",
    "bundle:check": "expo export --platform ios"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-battery": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.1",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.2",
    "expo-doctor": "^1.17.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2"
  }
}
